# Application
APP_ENV=development
APP_NAME=ClaraMed
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Database
# IMPORTANT: If password contains special characters (@, :, /, etc.), they must be URL-encoded
# Example: pass@word becomes pass%40word
# Use: python scripts/encode_database_url.py "your_password" to get encoded URL
DATABASE_URL=postgresql://claramed:your_password_here@localhost:5432/claramed
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Groq AI
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Vision model used to describe non-chest X-rays (images are sent to Groq)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optional but recommended: Gemini reads any X-ray (hand, leg, spine...). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-latest
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=1024

# Tesseract OCR
# Windows: C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux/Mac: /usr/bin/tesseract or just 'tesseract'
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGES=eng

# Radiology AI
RADIOLOGY_MODEL_NAME=densenet121-res224-all
RADIOLOGY_DEVICE=cpu
# Recommended: Use a dedicated cache directory (e.g., D:/ClaraMedCache/models on Windows)
RADIOLOGY_MODEL_CACHE_DIR=./models/cache
RADIOLOGY_BATCH_SIZE=1

# File Storage
STORAGE_TYPE=local  # Alias for STORAGE_PROVIDER
STORAGE_PROVIDER=local  # Options: local, s3
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=claramed-uploads
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
ANALYSIS_TIMEOUT_SECONDS=120
MAX_IMAGE_DIMENSION=4096

# Security
API_KEY_HASH_SECRET=change_this_to_a_secure_random_string
SECRET_KEY=change_this_to_a_secure_random_string_for_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Client integration (JeevaCare etc.) - see docs/CLARAMED_API.md
# Webhook URL, secret and allowed file hosts are set PER CLIENT: python scripts/register_client.py --help
CLARAMED_INTEGRATION_ENABLED=true
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_BACKOFF_BASE_SECONDS=120
CALLBACK_TIMEOUT_SECONDS=10
RESULT_RETENTION_DAYS=30
STALE_JOB_SECONDS=1800
# API key the bundled Streamlit UI uses (register a client for it with scripts/register_client.py)
CLARAMED_API_KEY=
# Deprecated and unused (kept so old .env files still load):
JEEVACARE_WEBHOOK_SECRET=
JEEVACARE_CALLBACK_URL=

# Supported Languages
SUPPORTED_LANGUAGES=English,Hindi,Kannada,Tamil,Telugu,Spanish,French

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
