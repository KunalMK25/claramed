# Installed to /etc/claramed/claramed.env (root:claramed, mode 640). NEVER commit the real file.
# Generate random values with:  openssl rand -hex 32
# Secrets sit in URLs/headers: use hex strings, avoid the characters @ : / in the database password.

APP_ENV=production
DEBUG=false

# --- database and queue (both run on this VM, loopback only) ---
DATABASE_URL=postgresql://claramed:CHANGE_ME@127.0.0.1:5432/claramed
REDIS_URL=redis://127.0.0.1:6379/0

# --- secrets: random, at least 32 characters; the app refuses to start in production otherwise ---
API_KEY_HASH_SECRET=CHANGE_ME
SECRET_KEY=CHANGE_ME

# --- LLM for report explanations (document analysis sends extracted text to Groq; see TODOS.md) ---
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-120b

# --- files: api and worker run on the same disk, so local storage is safe ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/var/lib/claramed/storage
STORAGE_SHARED_CONFIRMED=true
TESSERACT_CMD=tesseract

# --- sizing: each worker process adds about 0.55 GB of RAM ---
WORKER_CONCURRENCY=1

# --- integration behaviour (defaults shown) ---
CLARAMED_INTEGRATION_ENABLED=true
RESULT_RETENTION_DAYS=30
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_BACKOFF_BASE_SECONDS=120
STALE_JOB_SECONDS=1800
MAX_UPLOAD_SIZE_MB=10
